# Template only. Store the populated copy at /etc/market-stress/staging.env (0600).
STAGING_ROOT=/srv/market-stress
# Verified output from scripts/staging_state.py artifacts; used at build time.
STAGING_ARTIFACT_BUNDLE=/srv/market-stress/release-artifacts
SITE_ADDRESS=
PAPER_ALLOWED_ORIGINS=
PAPER_SESSION_SECRET=
FRED_API_KEY=
KRX_API_KEY=
ECOS_API_KEY=
# Enable only after the controlled first refresh succeeds.
MARKET_REFRESH_ENABLED=false
