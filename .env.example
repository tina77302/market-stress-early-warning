# API Keys
FRED_API_KEY=your_fred_api_key_here

# Server Settings
APP_ENV=development
PORT=8000

# Simulated portfolio workspace (generate a private random secret; never publish it)
PAPER_SESSION_SECRET=
PAPER_DB_PATH=data/paper/workspace.sqlite3
PAPER_STARTING_USD=100000
PAPER_STARTING_KRW=100000000
PAPER_MAX_PRICE_AGE_DAYS=5
PAPER_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Set true when deployed behind HTTPS
PAPER_COOKIE_SECURE=false
# Backend-only URL used by the Next.js same-origin workspace proxy
# Set API_INTERNAL_URL in the frontend runtime environment (default below).
# API_INTERNAL_URL=http://127.0.0.1:8000

# Optional legacy administrator bootstrap; prefer python -m src.admin.create_admin
# for multiple independent admins with hidden password prompts. Backend-only.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Explicit opt-in only; an existing normal account keeps its existing password.
ADMIN_BOOTSTRAP_PROMOTE_EXISTING=false

# Data reliability: production enables catch-up polling; false for local research.
MARKET_REFRESH_ENABLED=false
# Optional operational storage override; default data/operations
# MARKET_OPERATIONS_DIR=/persistent/market-operations
